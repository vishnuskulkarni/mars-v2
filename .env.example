# ============================================================================
# MARS — credentials (.env). Copy to .env and fill in. Never commit .env.
#
# Model ROUTING (which agent uses which provider/model) lives in config.yaml.
# This file holds ONLY secrets.
# ============================================================================

# The lab Claude service-account key — a standard Anthropic API key owned and
# paid for by the lab. NOT a personal Claude Max/Pro subscription. This is the
# default provider for every agent.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Only needed if an agent is routed to provider: openrouter in
# config.yaml (cheap open models). Leave blank otherwise.
OPENROUTER_API_KEY=

# Ollama (optional local provider) needs no key. Configure its URL/model in
# config.yaml under providers.ollama. Install from https://ollama.com and pull
# a model, e.g.  ollama pull qwen2.5:14b

# ----------------------------------------------------------------------------
# The variables below are only used by the LEGACY v2.1 FastAPI app (backend/).
# The Streamlit tool ignores them. Safe to leave as-is.
# ----------------------------------------------------------------------------
LLM_PROVIDER=anthropic
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
CLAUDE_MODEL=claude-sonnet-4-6
MAX_FILE_SIZE_MB=50
MAX_FILES=20
PORT=8000
